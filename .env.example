# OpenAI 연결 설정
# 이 파일을 .env로 복사한 뒤 값을 채우세요.  cp .env.example .env
#
# 주의: Vite는 VITE_ 접두사가 붙은 값을 브라우저 번들에 그대로 넣습니다.
#       .env의 키는 로컬 개발 편의용이며, 배포하는 빌드에는 넣지 마세요.
#       배포본에서는 화면 상단의 "OpenAI 연결" 입력칸에 키를 직접 넣어 쓰면 됩니다.

# API 키 (https://platform.openai.com/api-keys)
VITE_OPENAI_API_KEY=

# 사용할 모델명
VITE_OPENAI_MODEL=gpt-4o-mini

# OpenAI 호환 엔드포인트 (Azure/프록시/로컬 서버를 쓸 때만 변경)
VITE_OPENAI_BASE_URL=https://api.openai.com/v1
